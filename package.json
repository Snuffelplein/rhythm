{
  "name": "rhythm",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite apps/prototype-web --host 127.0.0.1",
    "dev:mobile": "node scripts/start-phone-preview.mjs",
    "dev:mobile:lan": "node scripts/start-mobile.mjs",
    "build": "tsc --noEmit && vite build apps/prototype-web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:flow": "node tests/log-flow-browser.mjs",
    "test:ai": "node tests/local-ai-smoke.mjs",
    "preview": "vite preview apps/prototype-web --host 127.0.0.1",
    "test:mobile": "node tests/phone-preview.mjs",
    "test:phone-link": "node tests/phone-tunnel.mjs",
    "test:mobile:lan": "node tests/mobile-preview.mjs",
    "test:visual": "node tests/visual-design.mjs",
    "test:pwa": "node tests/pwa-browser.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "test:cloud": "node tests/cloud-browser.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@mlc-ai/web-llm": "^0.2.88",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fast-check": "^4.5.0",
    "playwright": "^1.58.0",
    "qrcode": "^1.5.4",
    "supabase": "3.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
