{
  "name": "rhythm",
  "version": "0.8.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite apps/prototype-web --host 127.0.0.1",
    "dev:mobile": "node scripts/start-phone-preview.mjs",
    "dev:mobile:lan": "node scripts/start-mobile.mjs",
    "build": "tsc --noEmit && vite build apps/prototype-web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:flow": "node tests/log-flow-browser.mjs",
    "test:ai": "node tests/local-ai-smoke.mjs",
    "preview": "vite preview apps/prototype-web --host 127.0.0.1",
    "test:mobile": "node tests/phone-preview.mjs",
    "test:phone-link": "node tests/phone-tunnel.mjs",
    "test:mobile:lan": "node tests/mobile-preview.mjs",
    "test:visual": "node tests/visual-design.mjs",
    "test:pwa": "node tests/pwa-browser.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "test:cloud": "node tests/cloud-browser.mjs",
    "test:security": "node tests/security-browser.mjs",
    "test:hosted": "node tests/hosted-preview.mjs",
    "test:guidance": "node tests/guidance-browser.mjs",
    "test:push": "node tests/push-database.mjs && node tests/push-protocol.mjs",
    "test:push:browser": "node tests/push-browser.mjs",
    "test:push:hosted": "node tests/push-hosted.mjs",
    "security:deps": "npm audit --audit-level=low",
    "test:account": "node tests/account-database.mjs && node tests/cloud-browser.mjs && node tests/account-data-browser.mjs && node tests/recovery-browser.mjs && node tests/recovery-cross-context.mjs",
    "test:whisper:nl": "node tests/whisper-nl-browser.mjs",
    "build:coach": "node scripts/build-coach-edge.mjs",
    "test:coach": "node scripts/build-coach-edge.mjs && node tests/coach-database.mjs && node tests/coaching-browser.mjs",
    "test:gemma4": "node tests/gemma4-browser.mjs",
    "test:recovery": "node tests/recovery-browser.mjs",
    "test:recovery:cross-context": "node tests/recovery-cross-context.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@mlc-ai/web-llm": "^0.2.88",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fast-check": "^4.5.0",
    "playwright": "^1.58.0",
    "qrcode": "^1.5.4",
    "supabase": "3.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.0",
    "web-push": "4.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
